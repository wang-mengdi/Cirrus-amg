{
  "ny": 16,
  "embedded_geometry": "output/twisted/reproduce_geometry_n16.json",
  "adaptive": false,
  "periodic_x": true,
  "periodic_z": false,
  "convection": true,
  "convection_scheme": "fou",
  "rho": 1.0,
  "nu": 0.01,
  "force": [1.0, 0.0, 0.0],
  "alpha_u": 0.7,
  "alpha_p": 0.3,
  "anderson_depth": 0,
  "tolerance": 1e-8,
  "linear_tolerance": 1e-11,
  "max_iterations": 1000,
  "nonorth_iterations": 1,
  "pressure_solver": "ldlt",
  "dump_iterations": [0, 1, 2, 10],
  "time_step": 1.0,
  "time_steps": 8,
  "output": "output/twisted/reproduce_ns16_steady"
}

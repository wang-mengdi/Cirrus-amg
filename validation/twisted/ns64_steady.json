{
  "ny": 64,
  "embedded_geometry": "output/twisted/geometry_n64_shift.json",
  "adaptive": true,
  "periodic_x": true,
  "periodic_z": false,
  "convection": true,
  "convection_scheme": "fou",
  "rho": 1,
  "nu": 0.01,
  "force": [1, 0, 0],
  "alpha_u": 0.85,
  "alpha_p": 0.3,
  "anderson_depth": 5,
  "tolerance": 1e-8,
  "linear_tolerance": 1e-11,
  "max_iterations": 3000,
  "nonorth_iterations": 1,
  "pressure_solver": "amg",
  "dump_iterations": [0, 1, 2, 10],
  "output": "output/twisted/reproduce_ns64_steady",
  "time_step": 1,
  "time_steps": 8
}

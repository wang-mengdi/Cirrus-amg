+template <class M>
+class SimplePerturb : public ModuleInitVelocity<M> {
+ public:
+  using Vect = typename M::Vect;
+  SimplePerturb() : ModuleInitVelocity<M>("simple-perturb") {}
+  void operator()(FieldCell<Vect>& fcv, const Vars& var, const M& m) override {
+    const double a = var.Double("simple_perturb_amplitude", 0.01);
+    const double height = var.Double("simple_perturb_height", 0.125);
+    for (auto c : m.AllCells()) {
+      const auto x = m.GetCenter(c);
+      auto& v = fcv[c];
+      v = Vect(0);
+      v[0] = a * std::sin(2*M_PI*x[0]) * std::sin(M_PI*x[1]/height);
+      v[1] = a * std::cos(2*M_PI*x[0]) * std::sin(2*M_PI*x[1]/height);
+    }
+  }
+};
